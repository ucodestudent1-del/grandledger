# Backend
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/grandledger
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
DEBUG=True
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# App - FRONTEND_URL is the production Railway URL (same origin as API)
# In development, the frontend dev server runs on http://localhost:3000.
# In production, the frontend is served directly from the API service,
# so FRONTEND_URL should match the deployed application URL.
FRONTEND_URL=http://localhost:3000

# Security
PASSWORD_MIN_LENGTH=8
BCRYPT_ROUNDS=12

# OAuth (Google Sign-In)
GOOGLE_CLIENT_ID=57226020458-rkiaohbs73j23t5s1oog23dqn4lkpha2.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=57226020458-rkiaohbs73j23t5s1oog23dqn4lkpha2.apps.googleusercontent.com
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback/google
