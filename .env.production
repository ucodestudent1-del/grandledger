# Production Environment Variables
# Copy this to .env.production and fill in real values

# Backend - use Docker service names for networking
DATABASE_URL=postgresql+psycopg2://postgres:changeme@postgres:5432/grandledger
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
DEBUG=False
ENVIRONMENT=production
ALLOWED_ORIGINS=https://yourdomain.com

# Frontend URL (your production domain)
FRONTEND_URL=https://yourdomain.com
NEXT_PUBLIC_API_URL=https://yourdomain.com

# Security
PASSWORD_MIN_LENGTH=8
BCRYPT_ROUNDS=12

# SMTP for password reset and email verification
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_USE_TLS=True
SMTP_FROM=noreply@yourdomain.com

# Email verification
VERIFY_TOKEN_EXPIRE_MINUTES=1440

# Password reset
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL password (used by docker-compose)
POSTGRES_PASSWORD=changeme

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourdomain.com/auth/callback/google
